# Environment Configuration for ChainSentinel AI

# Application
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database Configuration (Standalone SQLite by default - No Docker needed!)
DATABASE_TYPE=sqlite
DATABASE_PATH=chainsentinel.sqlite

# Optional PostgreSQL URL (Used only if DATABASE_TYPE=postgres)
# DATABASE_URL=postgresql://chainsentinel:chainsentinel_dev_2026@localhost:5432/chainsentinel

# Neo4j Graph Database (Optional - in-memory fallback active if offline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chainsentinel_dev_2026

# Redis & Queue (Optional)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_chainsentinel_dev_2026_key_for_development
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_chainsentinel_dev_2026_key_for_development
JWT_REFRESH_EXPIRATION=7d

# Blockchain Providers (Optional / Sandbox)
ALCHEMY_API_KEY=
INFURA_API_KEY=
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=

# Evidence Engine — HMAC signing key for evidence packages (rotate in production; never commit real keys)
EVIDENCE_SIGNING_KEY=change_me_evidence_signing_key_dev_only

# ML Risk Model (trained by `python ml/setup_and_train.py`)
# Path to the exported artifacts (model.json + manifest.json). Defaults to ml/artifacts.
ML_MODEL_PATH=ml/artifacts
